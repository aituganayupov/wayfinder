rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Данные человека (накопления, дела, заметки…) — видит и меняет только он сам
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // «Сейф» со служебным секретом. Внутри только зашифрованный текст, поэтому
    // читать по логину можно (так работает вход), а менять — только владелец этого логина
    match /vaults/{login} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.token.email == login + '@wayfinder.login'
        && request.resource.data.keys().hasOnly(['v', 'iter', 'pw', 'rec']);
      allow delete: if request.auth != null
        && request.auth.token.email == login + '@wayfinder.login';
    }
  }
}
